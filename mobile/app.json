{
  "expo": {
    "name": "Gymzy",
    "slug": "gymzy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "gymzy",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymzy.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Gymzy uses your location to show nearby gyms.",
        "NSLocationAlwaysUsageDescription": "Gymzy uses your location to show nearby gyms.",
        "NSCameraUsageDescription": "Gymzy needs camera access for profile photos and QR scanning.",
        "NSPhotoLibraryUsageDescription": "Gymzy needs photo library access for gym images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.gymzy.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-camera",
        {
          "cameraPermission": "Gymzy needs camera for profile photos and QR check-in."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6B35"
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "http://172.20.10.4:5001/api",
      "googleMapsApiKey": "AIzaSyBrqeB1lBJYLNEY1hJDD9KERdxr78k1Z7M"
    }
  }
}
